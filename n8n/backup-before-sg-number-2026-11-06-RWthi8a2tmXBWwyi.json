   {
    "parameters": {
     "jsCode": "const conv = $('Loop Over Items').item.json;\nconst lastMsg = $input.item.json;\nconst now = new Date();\n\nconst lastIncoming = conv.last_incoming_at\n  ? new Date(conv.last_incoming_at)\n  : null;\n\nconst lastOutgoing = lastMsg.created_at\n  ? new Date(lastMsg.created_at)\n  : null;\n\nconst stage = Number(conv.follow_up_stage || 0);\n\nconst phone = conv.phone || '';\nconst conversationId = conv.id || '';\nconst name = conv.name || 'there';\n\nconst lang = String(conv.lang || conv.language || 'id')\n  .trim()\n  .toLowerCase();\n\nconst isEnglish =\n  ['en', 'eng', 'english'].includes(lang);\n\nconst langCode = isEnglish ? 'en' : 'id';\n\nconst templateName = isEnglish\n  ? 'followup_eng_48hr'\n  : 'followup_indo_48hrs';\n\n/*\n * Do not send if the user has already received\n * the Version 3 follow-up.\n */\nif (stage !== 0) {\n  return [{\n    json: {\n      sendFollowUp: false,\n      reason: 'Follow-up already sent',\n      stage,\n      phone,\n      conversationId,\n      name\n    }\n  }];\n}\n\n/*\n * A valid outgoing message is required because\n * the 48-hour countdown starts from that message.\n */\nif (!lastOutgoing) {\n  return [{\n    json: {\n      sendFollowUp: false,\n      reason: 'No outgoing message found',\n      stage,\n      phone,\n      conversationId,\n      name\n    }\n  }];\n}\n\n/*\n * Do not follow up if the customer replied after\n * the most recent outgoing message.\n */\nif (\n  lastIncoming &&\n  lastIncoming > lastOutgoing\n) {\n  return [{\n    json: {\n      sendFollowUp: false,\n      customerReplied: true,\n      reason: 'Customer already replied',\n      stage,\n      phone,\n      conversationId,\n      name\n    }\n  }];\n}\n\nconst hoursSinceOutgoing =\n  (now - lastOutgoing) / (1000 * 60 * 60);\n\nconst sendFollowUp =\n  hoursSinceOutgoing >= 0.1;\n\nreturn [{\n  json: {\n    sendFollowUp,\n    customerReplied: false,\n    reason: sendFollowUp\n      ? '48-hour follow-up due'\n      : 'Waiting for 48 hours',\n    templateNum: 1,\n    templateName,\n    langCode,\n    newStage: 1,\n    hoursSinceOutgoing,\n    phone,\n    conversationId,\n    name\n  }\n}];"
    },
