   {
    "parameters": {
     "jsCode": "const d = $input.item.json;\nconst now = new Date();\n\nconst sgtTime = new Intl.DateTimeFormat('en-SG', {\n  timeZone: 'Asia/Singapore',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: true\n}).format(now);\n\nconst TEMPLATE_BODIES = {\n  followup_eng_48hr:\n    \"Hello {{1}}, we'd like to follow up on your previous message. 😊 \" +\n    \"Do you still need help finding a doctor, a hospital, or scheduling an in-person appointment in Singapore/Malaysia? \" +\n    \"If there’s anything else we can do to help, feel free to reply to this message.\",\n\n  followup_indo_48hrs:\n    \"Halo {{1}}, kami ingin follow up terkait pesan Anda sebelumnya. 😊 \" +\n    \"Apakah Anda masih membutuhkan bantuan untuk mencari dokter, rumah sakit, atau mengatur janji temu di Singapura dan Malaysia? \" +\n    \"Jika masih ada yang bisa kami bantu, silakan balas pesan ini.\"\n};\n\nconst bodyTemplate = TEMPLATE_BODIES[d.templateName];\n\nconst renderedText = bodyTemplate\n  ? bodyTemplate.replaceAll('{{1}}', d.name || 'there')\n  : `[Template: ${d.templateName}]`;\n\nconst updatePayload = {\n  follow_up_stage: 1,\n  follow_up_1_sent_at: now.toISOString(),\n  follow_up: false,\n  last_message: renderedText,\n  last_message_time: now.toISOString(),\n  last_message_time_sgt: sgtTime\n};\n\nreturn [{\n  json: {\n    ...d,\n    updatePayload,\n    sgtTime,\n    renderedText\n  }\n}];"
    },
