     "jsCode": "const ROLLOUT_DATE = new Date('2026-09-24T16:00:00.000Z');\n// 25 Sep 2026, 00:00 Singapore time\n\nreturn $input.all().filter(item => {\n  const c = item.json;\n\n  const lastIncoming = c.last_incoming_at\n    ? new Date(c.last_incoming_at)\n    : null;\n\n  return (\n    c.follow_up === true &&\n    c.opted_out !== true &&\n    Number(c.follow_up_stage || 0) === 0 &&\n    c.status !== 'completed' &&\n    c.status !== 'inactive' &&\n    lastIncoming &&\n    lastIncoming >= ROLLOUT_DATE\n  );\n});"
